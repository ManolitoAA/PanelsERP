# Ejemplo: postgresql+psycopg://USUARIO:PASSWORD@localhost:5433/NOMBRE_BD (vacío = SQLite local)
DATABASE_URL=
# Obligatoria (el backend no arranca sin ella). Genera una: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@empresa.com
# Bot de Telegram (crear con @BotFather; tu ID numérico con @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Email del usuario del ERP en cuyo nombre crea pedidos el bot
TELEGRAM_ERP_USER_EMAIL=
# Clave de Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
