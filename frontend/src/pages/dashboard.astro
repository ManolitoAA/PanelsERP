---
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>PanelsERP – Dashboard</title>
  </head>
  <body class="bg-slate-50 min-h-screen">
    <header class="bg-white border-b border-slate-200 px-6 py-3 flex items-center justify-between">
      <h1 class="text-lg font-bold text-blue-700">PanelsERP</h1>
      <button id="logout" class="text-sm text-slate-500 hover:text-red-500">Cerrar sesión</button>
    </header>
    <main class="max-w-5xl mx-auto px-4 py-8">
      <h2 class="text-xl font-semibold text-slate-800 mb-6" id="greeting">Mis Clientes</h2>
      <div id="client-list-root"></div>
    </main>
    <script type="module">
      import ClientList from '/src/components/ClientList.jsx';
      import { createRoot } from 'react-dom/client';
      import React from 'react';

      const token = localStorage.getItem('token');
      const name = localStorage.getItem('name');
      if (!token) window.location.href = '/';

      const greeting = document.getElementById('greeting');
      if (name) greeting.textContent = `Mis Clientes – Hola, ${name}`;

      document.getElementById('logout').addEventListener('click', () => {
        localStorage.clear();
        window.location.href = '/';
      });

      createRoot(document.getElementById('client-list-root')).render(React.createElement(ClientList));
    </script>
  </body>
</html>
