<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>PanelsERP – Login</title>
  </head>
  <body class="bg-slate-100 min-h-screen flex items-center justify-center">
    <main class="w-full max-w-sm bg-white rounded-2xl shadow-lg p-8">
      <h1 class="text-2xl font-bold text-blue-700 mb-1 text-center">PanelsERP</h1>
      <p class="text-sm text-slate-500 text-center mb-6">Gestión comercial y exportación</p>
      <div id="login-root"></div>
    </main>
    <script type="module">
      import LoginForm from '/src/components/LoginForm.jsx';
      import { createRoot } from 'react-dom/client';
      import React from 'react';
      createRoot(document.getElementById('login-root')).render(React.createElement(LoginForm));
    </script>
  </body>
</html>
