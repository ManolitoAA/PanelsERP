---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/LoginForm.jsx';
---
<Layout title="Login">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-brand-900 to-brand-600 p-4">
    <main class="w-full max-w-sm bg-white rounded-2xl shadow-xl p-8">
      <h1 class="text-3xl font-bold text-brand-700 mb-1 text-center">PanelsERP</h1>
      <p class="text-sm text-slate-500 text-center mb-6">Gestión comercial y exportación</p>
      <LoginForm client:only="react" />
    </main>
  </div>
</Layout>
