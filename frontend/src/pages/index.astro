---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/LoginForm.jsx';
---
<Layout title="Iniciar sesión">
  <main class="min-h-screen grid place-items-center px-4 py-10">
    <div class="enter w-full max-w-sm">
      <div role="img" aria-label="PanelsERP" class="flex items-center justify-center gap-2.5 mb-8">
        <span aria-hidden="true" class="grid place-items-center h-10 w-10 rounded-xl bg-accent-500 text-night text-lg font-semibold">P</span>
        <span aria-hidden="true" class="text-xl font-semibold tracking-display text-night">PanelsERP</span>
      </div>
      <div class="rounded-2xl bg-white border border-night/5 shadow-card p-6 md:p-8">
        <h1 class="text-2xl font-medium tracking-display text-night">Inicia sesión</h1>
        <p class="mt-1 mb-6 text-sm text-slate-600">Con tu email y contraseña de trabajo.</p>
        <LoginForm client:only="react" />
      </div>
    </div>
  </main>
</Layout>
