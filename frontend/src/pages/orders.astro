---
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>PanelsERP – Pedidos</title>
  </head>
  <body class="bg-slate-50 min-h-screen">
    <header class="bg-white border-b border-slate-200 px-6 py-3 flex items-center gap-4">
      <a href="/dashboard" class="text-sm text-blue-600 hover:underline">← Volver</a>
      <h1 class="text-lg font-bold text-blue-700">Nuevo Pedido</h1>
    </header>
    <main class="max-w-3xl mx-auto px-4 py-8">
      <div id="order-form-root"></div>
    </main>
    <script type="module">
      import OrderForm from '/src/components/OrderForm.jsx';
      import { createRoot } from 'react-dom/client';
      import React from 'react';

      const token = localStorage.getItem('token');
      if (!token) window.location.href = '/';

      const params = new URLSearchParams(window.location.search);
      const clientId = Number(params.get('client_id'));

      createRoot(document.getElementById('order-form-root')).render(
        React.createElement(OrderForm, {
          clientId,
          onSuccess: () => { window.location.href = '/dashboard'; }
        })
      );
    </script>
  </body>
</html>
